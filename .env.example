# Copy to .env (in this folder or in backend/) and adjust. Never commit .env.

# development | test | production
APP_ENV=development

# SQLite (default, no server needed). Relative paths are resolved from where you start
# the backend, so prefer leaving this unset to use backend/triveni_kavach.db.
# DATABASE_URL=sqlite:///./triveni_kavach.db
# PostgreSQL alternative (install requirements first; psycopg is included):
# DATABASE_URL=postgresql+psycopg://triveni:change-me@localhost:5432/triveni_kavach

# Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Browser origins allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Species enabled for animal-health screening (must exist in the model). Poultry is not in the model.
SCREENING_ENABLED_SPECIES=Pig

# Software-only telemetry simulator. Device source stays disabled: no device integration exists.
ENABLE_TELEMETRY_SIMULATOR=true
ALLOW_DEVICE_SOURCE=false

LOG_LEVEL=INFO

# Live regional weather from Open-Meteo (free, no key; attribution shown in the UI).
WEATHER_ENABLED=true

# Optional: Open Government Data Platform India key, for importing Livestock Census tables.
# Register at https://data.gov.in, then generate a key under "My Account".
DATA_GOV_IN_API_KEY=

# Failed sign-ins allowed per e-mail + client address within the window.
LOGIN_MAX_FAILURES=8
LOGIN_WINDOW_MINUTES=15

# Used only by scripts/seed_demo.py for the fictional development accounts
# (min 10 chars, letters and digits). If unset, a random password is generated and printed.
# DEMO_PASSWORD=
